{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/patala-pay/PointofSale", "destination": "/" },
    { "source": "/patala-pay/PointofSale/:path*", "destination": "/" },
    { "source": "/PointofSale", "destination": "/" },
    { "source": "/PointofSale/:path*", "destination": "/" },
    { "source": "/patala-pay", "destination": "/" },
    { "source": "/patala-pay/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
